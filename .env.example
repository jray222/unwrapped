# Copy to .env and replace every placeholder. Never commit .env.
# Keep values unquoted and free of spaces and '#': both Compose and make read this file.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost
SITE_ADDRESS=localhost

POSTGRES_DB=unwrapped
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=replace-me

APP_DB_USER=unwrapped_app
APP_DB_PASSWORD=replace-me

MIGRATOR_DB_USER=unwrapped_migrator
MIGRATOR_DB_PASSWORD=replace-me
