# ==============================================================================
# Unwrapped v2 — Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
# Domain name for Caddy automatic HTTPS, WebAuthn Relying Party ID, and origin
DOMAIN=wishlist.example.com

# Node environment: 'production' or 'development'
NODE_ENV=production

# Internal application port (default: 3000)
PORT=3000

# Base URL origin of the deployed application (must match scheme and domain)
APP_ORIGIN=https://wishlist.example.com

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL password used by the docker-compose postgres container
POSTGRES_PASSWORD=replace_with_a_secure_random_db_password

# Database connection URL with Row-Level Security support
# For Docker Compose stack:
DATABASE_URL=postgres://unwrapped:replace_with_a_secure_random_db_password@postgres:5432/unwrapped
# For local in-memory development (no external DB needed):
# DATABASE_URL=pglite://memory

# ------------------------------------------------------------------------------
# 3. Security, Sessions & Bootstrap Tokens
# ------------------------------------------------------------------------------
# 64-character hexadecimal session & CSRF signing secret
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_64_character_hex_random_secret

# Bootstrap Instance Admin Token
# Used to authenticate as the content-blind Instance Admin to create initial families
BOOTSTRAP_INSTANCE_ADMIN_TOKEN=replace_with_a_secure_bootstrap_token

# ------------------------------------------------------------------------------
# 4. WebAuthn / Passkeys Configuration
# ------------------------------------------------------------------------------
# rpID must match your domain (e.g. wishlist.example.com or localhost for dev)
WEBAUTHN_RP_ID=wishlist.example.com
WEBAUTHN_RP_NAME="Unwrapped Family Wish List"

# ------------------------------------------------------------------------------
# 5. Google Sign-In (Optional - OpenID Connect)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
